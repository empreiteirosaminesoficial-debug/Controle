rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'empreiteirosaminesoficial@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Backups privados: apenas administrador verificado, com tamanho e tipo controlados.
    match /backups/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType == 'application/gzip';
    }
    // APK oficial publicado pelo administrador. Clientes autenticados podem baixar;
    // somente o administrador verificado pode enviar ou substituir versões.
    match /app-releases/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin()
        && request.resource.size > 0
        && request.resource.size < 200 * 1024 * 1024
        && request.resource.contentType == 'application/vnd.android.package-archive';
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
